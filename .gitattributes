# Normalise line endings in the repository.
#
# Shell scripts and container config must be checked out with LF even on
# Windows: a CRLF in a shebang makes the kernel look for an interpreter named
# "/bin/sh\r", and the container fails to start with a misleading "not found".

* text=auto

*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary assets, never converted.
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
